    <div class="hi-icon">🔗</div>
    <div class="hi-body"><b>ডেটা ইন্টিগ্রিটি</b><small>সব টেবিল সঠিকভাবে লোড হয়েছে</small></div>
    <div class="hi-val" style="color:var(--green)">✓ ভালো</div>
  </div>
  <div class="health-item">
    <div class="hi-icon">⚡</div>
    <div class="hi-body"><b>পারফরম্যান্স</b><small>${bn(totalRecords)} রেকর্ড • দ্রুত লোড</small></div>
    <div class="hi-val" style="color:var(--green)">দ্রুত</div>
  </div>
  <div class="health-item">
    <div class="hi-icon">📋</div>
    <div class="hi-body"><b>অডিট লগ</b><small>${bn(logsCount)} টি এন্ট্রি সংরক্ষিত</small></div>
    <div class="hi-val" style="color:var(--green)">✓ সক্রিয়</div>
  </div>
  <div class="health-item">
