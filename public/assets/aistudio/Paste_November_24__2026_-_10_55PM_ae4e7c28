/* ============ IMPORT / EXPORT ============ */
function downloadBlob(blob, name){
  const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = name;
  document.body.appendChild(a); a.click();
  setTimeout(()=>{ URL.revokeObjectURL(a.href); a.remove(); }, 200);
}
function downloadBackup(){
  if(!requireAdmin()) return;
  const blob = new Blob([JSON.stringify(db, null, 2)], {type:'application/json'});
  downloadBlob(blob, 'mosque-backup-'+today()+'.json');
  toast('ব্যাকআপ ডাউনলোড শুরু');
}
function restoreBackup(e){
  if(!requireAdmin()) return;
  const f = e.target.files[0]; if(!f) return;
  const r = new FileReader();
  r.onload = ()=>{
    try{
      const v = JSON.parse(r.result);
      if(!v || !Array.isArray(v.families) || !Array.isArray(v.payments)) throw new Error();
      if(!confirm('বর্তমান ডেটা প্রতিস্থাপিত হবে। নিশ্চিত?')) return;
      db = Object.assign(blankDB(), v); save(); render(); toast('ব্যাকআপ ফিরিয়ে আনা হয়েছে');
    }catch(_){ toast('সঠিক ফাইল নয়','error'); }
    e.target.value = '';
  };
  r.readAsText(f);
}
function exportCSV(){
  const rows = [
    ['ধরন','তারিখ','বিবরণ','খাত/চাঁদা','মাধ্যম','পরিমাণ'],
    ...db.payments.map(x=>['আদায়', x.date, familyName(x.family), duename(x.due), x.method||'', x.amount]),
    ...db.expenses.map(x=>['ব্যয়', x.date, x.title, x.category||'', '', -x.amount])
  ];
  const csv = '\ufeff' + rows.map(r=>r.map(v=>'"'+String(v ?? '').replace(/"/g,'""')+'"').join(',')).join('\r\n');
  downloadBlob(new Blob([csv], {type:'text/csv;charset=utf-8'}), 'mosque-report-'+today()+'.csv');
  toast('CSV ডাউনলোড');
}

/* ============ SETTINGS ACTIONS ============ */
function changePin(){
  if(!requireAdmin()) return;
  const p = prompt('নতুন PIN (কমপক্ষে ৬ অঙ্ক):');
  if(p === null) return;
  if(!/^\d{6,}$/.test(p)){ toast('কমপক্ষে ৬ সংখ্যা','error'); return; }
  localStorage.setItem(PINKEY, p); toast('PIN পরিবর্তন');
}
function clearAll(){
  if(!requireAdmin()) return;
  if(!confirm('সব স্থানীয় তথ্য স্থায়ীভাবে মুছে যাবে। নিশ্চিত?')) return;
  if(!confirm('শেষবার — ব্যাকআপ ছাড়া ফেরানো যাবে না। চালিয়ে যাবেন?')) return;
  localStorage.removeItem(KEY); localStorage.removeItem(OLDKEY);
  db = blankDB(); save(); render(); toast('সব ডেটা মুছে ফেলা হয়েছে','warn');
}

/* ============ THEME ============ */
function applyTheme(t){
  document.documentElement.setAttribute('data-theme', t);
  localStorage.setItem(THEMEKEY, t);
  $('#themeBtn').textContent = t==='dark' ? '☀' : '🌙';
  setTimeout(()=>{ if($('#chart')) drawChart(); }, 60);
  if(page === 'appearance') render();
}
function toggleTheme(){
  const cur = document.documentElement.getAttribute('data-theme')==='dark' ? 'light' : 'dark';
  applyTheme(cur);
}

/* ============ SEARCH WIRE ============ */
function wireSearch(){
  const el = $('#search'); if(!el) return;
  el.addEventListener('input', ()=>{
    const q = el.value.trim().toLowerCase();
    $$('#content tbody tr').forEach(r=>{ r.style.display = !q || r.textContent.toLowerCase().includes(q) ? '' : 'none'; });
  });
}

/* ============ RENDER ROUTER ============ */
function render(){
  $('#roleBadge').textContent = admin ? 'অ্যাডমিন মোড' : 'শুধু দেখার মোড';
  $('#roleBadge').className = 'badge ' + (admin?'':'gray');
  $('#loginBtn').textContent = admin ? 'লগআউট' : 'অ্যাডমিন লগইন';
  const c = $('#content');
  switch(page){
    case 'dashboard': c.innerHTML = viewDashboard(); break;
    case 'families': c.innerHTML = viewFamilies(); wireSearch(); break;
    case 'members': c.innerHTML = viewMembers(); wireSearch(); break;
    case 'dues': c.innerHTML = viewDues(); break;
    case 'payments': c.innerHTML = viewPayments(); wireSearch(); break;
    case 'expenses': c.innerHTML = viewExpenses(); break;
    case 'qurbani': c.innerHTML = viewQurbani(); break;
    case 'distribution': c.innerHTML = viewDistribution(); wireSearch(); break;
    case 'notices': c.innerHTML = viewNotices(); break;
    case 'portal': c.innerHTML = viewPortal(); break;
    case 'prayer': c.innerHTML = viewPrayer(); break;
    case 'committee': c.innerHTML = viewCommittee(); break;
    case 'social': c.innerHTML = viewSocial(); break;
    case 'assets': c.innerHTML = viewAssets(); break;
    case 'events': c.innerHTML = viewEvents(); break;
    case 'reports': c.innerHTML = viewReports(); break;
    case 'analytics': c.innerHTML = viewAnalytics(); break;
    case 'transparency': c.innerHTML = viewTransparency(); break;
    case 'audit': c.innerHTML = viewAudit(); wireSearch(); break;
    case 'backup': c.innerHTML = viewBackup(); break;
    case 'security': c.innerHTML = viewSecurity(); break;
    case 'settings': c.innerHTML = viewSettings(); break;
    case 'roles': c.innerHTML = viewRoles(); break;
    case 'appearance': c.innerHTML = viewAppearance(); break;
    case 'automation': c.innerHTML = viewAutomation(); break;
    case 'api': c.innerHTML = viewApi(); break;
    case 'health': c.innerHTML = viewHealth(); break;
  }
  setTimeout(()=>{
    if($('#chart')) drawChart();
    /* responsive grids */
    if(window.innerWidth < 900){
      ['dashBottom','repBottom','anaGrid','portalGrid','setGrid','roleGrid','bkGrid','themeGrid'].forEach(id=>{
        const el = document.getElementById(id);
        if(el) el.style.gridTemplateColumns = '1fr';
      });
    }
  }, 30);
}

/* ============ LOGIN ============ */
$('#loginBtn').onclick = ()=>{
  if(admin){ admin = false; sessionStorage.removeItem('mosque_admin'); render(); toast('লগআউট','warn'); return; }
  const pin = prompt('অ্যাডমিন PIN (ডিফল্ট: 123456):'); if(pin === null) return;
  const saved = localStorage.getItem(PINKEY) || '123456';
  if(pin === saved){
    admin = true; sessionStorage.setItem('mosque_admin','yes'); render(); toast('স্বাগতম, অ্যাডমিন!');
  } else { toast('ভুল PIN','error'); }
};

/* ============ GLOBAL EVENTS ============ */
$('#nav').addEventListener('click', e=>{ const b = e.target.closest('button[data-page]'); if(b) setPage(b.dataset.page); });
$('#hamburger').onclick = openSidebar;
$('#overlay').onclick = closeSidebar;
$('#themeBtn').onclick = toggleTheme;
$('#cancelModal').onclick = closeModal;
$('#saveModal').onclick = ()=>{ if(!formHandler) return; if(formHandler() !== false) closeModal(); };
$('#modal').addEventListener('click', e=>{ if(e.target.id==='modal') closeModal(); });
document.addEventListener('keydown', e=>{
  if(e.key === 'Escape' && $('#modal').classList.contains('show')) closeModal();
  if((e.ctrlKey || e.metaKey) && e.key === 'k'){ e.preventDefault(); const s=$('#search'); if(s) s.focus(); }
});
let resizeTimer;
window.addEventListener('resize', ()=>{ clearTimeout(resizeTimer); resizeTimer = setTimeout(()=>{ if($('#chart')) drawChart(); }, 140); });

/* ============ BOOT ============ */
(function boot(){
  applyTheme(localStorage.getItem(THEMEKEY) || 'light');
  buildNav();
  setPage('dashboard');
})();
</script>
