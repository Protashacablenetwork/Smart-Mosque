    ${customEvents.map(e=>`<div class="cal-item"><div class="cal-date"><div class="d">${bn(+(e.date.split('-')[2]))}</div><div class="m">${BN_MONTHS_SHORT[+e.date.split('-')[1]-1]}</div></div><div class="cal-body"><b>${esc(e.title)}</b><p>${esc(e.time||'')} ${e.location?' • '+esc(e.location):''}</p></div></div>`).join('')}
