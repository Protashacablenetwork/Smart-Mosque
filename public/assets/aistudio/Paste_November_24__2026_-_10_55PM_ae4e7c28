function showModal(title, html, handler){
  $('#modalTitle').textContent = title;
  $('#modalBody').innerHTML = html;
  $('#modal').classList.add('show');
  formHandler = handler || null;
  $('#saveModal').classList.toggle('hidden', !handler);
  $('#cancelModal').textContent = handler ? 'বাতিল' : 'বন্ধ করুন';
  setTimeout(()=>{ const f=$('#modalBody input, #modalBody select, #modalBody textarea'); if(f) f.focus(); },80);
}
function closeModal(){ $('#modal').classList.remove('show'); formHandler=null; }

function openForm(type, item){
  if(!requireAdmin()) return;
  const spec = FORMS[type]; if(!spec) return;
  const x = item || {};
  const html = `<form id="dataForm" class="formgrid">` + spec.fields.map(f=>{
    let v = x[f.k]!==undefined ? x[f.k] : (typeof f.def==='function' ? f.def() : (f.def!==undefined ? f.def : ''));
    let input;
    if(f.type==='select'){
      const opts = typeof f.options==='function' ? f.options() : f.options;
      input = `<select name="${f.k}">${opts.map(o=>`<option value="${esc(o[0])}" ${String(o[0])===String(v)?'selected':''}>${esc(o[1])}</option>`).join('')}</select>`;
    } else if(f.type==='textarea'){
      input = `<textarea name="${f.k}" rows="${f.rows||3}" placeholder="${esc(f.ph||'')}">${esc(v)}</textarea>`;
    } else {
      input = `<input name="${f.k}" type="${f.type||'text'}" value="${esc(v)}" placeholder="${esc(f.ph||'')}" ${f.step?`step="${f.step}"`:''} ${f.min!==undefined?`min="${f.min}"`:''}>`;
    }
    return `<div class="field ${f.full?'full':''}"><label>${f.l}${f.req?' <b class="req">*</b>':''}</label>${input}</div>`;
  }).join('') + `</form>`;

  showModal((item?'সম্পাদনা — ':'নতুন — ')+spec.title, html, form=>{
    const data = {}; new FormData(form).forEach((v,k)=>data[k]=v);
    for(const f of spec.fields){ if(f.req && !String(data[f.k]||'').trim()){ toast(f.l+' আবশ্যক','error'); return false; } }
    if(type==='payments'){
      if(db.payments.some(p=>p.receipt===data.receipt && p.id!==x.id)){ toast('রসিদ নম্বর আগে ব্যবহৃত','error'); return false; }
      if(!data.family){ toast('পরিবার নির্বাচন করুন','error'); return false; }
    }
    spec.fields.forEach(f=>{ if(f.num) data[f.k] = +data[f.k] || 0; });
    if(type==='families') data.active = data.active!=='false';
    if(type==='dues') data.active = data.active!=='false';
    if(type==='members') data.head = data.head==='true';
    if(type==='notices') data.pinned = data.pinned==='true';
    if(type==='committees') data.active = data.active!=='true'?false:true;
    if(type==='events') data.rsvp = data.rsvp==='true';
    if(type==='batches'){
      const fs = activeFamilies();
      data.families = fs.length; data.per = fs.length ? +(data.kg/fs.length).toFixed(3) : 0;
    }
    const table = spec.table;
    const rec = {...x, ...data, id: x.id || uid(), updatedAt: new Date().toISOString()};
    if(x.id){
      const i = db[table].findIndex(a=>a.id===x.id);
      if(i>-1) db[table][i] = rec; else db[table].unshift(rec);
      log('তথ্য সম্পাদনা', table, rec.id); toast('সফলভাবে আপডেট হয়েছে');
    } else {
      db[table].unshift(rec); log('নতুন তথ্য যোগ', table, rec.id); toast('সফলভাবে সংরক্ষিত হয়েছে');
    }
    save(); render(); return true;
  });
  if(type==='payments'){
    setTimeout(()=>{
      const sel = $('#dataForm [name="due"]'), amt = $('#dataForm [name="amount"]');
      if(sel && amt) sel.addEventListener('change', ()=>{ const d = db.dues.find(x=>x.id===sel.value); if(d) amt.value = d.amount; });
    },0);
  }
}
function editItem(type, idv){
  const spec = FORMS[type]; if(!spec) return;
  const x = db[spec.table].find(a=>a.id===idv); if(x) openForm(type, x);
}
function deleteItem(type, idv){
  if(!requireAdmin()) return;
  const spec = FORMS[type]; if(!spec) return;
  if(!confirm('তথ্যটি স্থায়ীভাবে মুছে ফেলবেন?')) return;
  db[spec.table] = db[spec.table].filter(x=>x.id!==idv);
  log('তথ্য মুছে ফেলা', spec.table, idv); save(); render(); toast('মুছে ফেলা হয়েছে','warn');
}

