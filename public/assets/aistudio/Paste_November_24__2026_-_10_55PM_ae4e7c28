/* ============ CHART ============ */
function drawChart(){
  const canvas = $('#chart'); if(!canvas) return;
  const rect = canvas.getBoundingClientRect(); const W=rect.width, H=rect.height; if(!W||!H) return;
  const dpr = window.devicePixelRatio || 1;
  canvas.width = W*dpr; canvas.height = H*dpr;
  const ctx = canvas.getContext('2d'); ctx.setTransform(dpr,0,0,dpr,0,0); ctx.clearRect(0,0,W,H);
  const cs = getComputedStyle(document.documentElement);
  const cGreen = cs.getPropertyValue('--green2').trim()||'#0d9d68';
  const cRed = cs.getPropertyValue('--red').trim()||'#c43d3d';
  const cMuted = cs.getPropertyValue('--muted').trim()||'#6b7b72';
  const cLine = cs.getPropertyValue('--line').trim()||'#e3ebe6';
  const now = new Date(); const months = [];
  for(let i=5;i>=0;i--){ const d=new Date(now.getFullYear(),now.getMonth()-i,1); months.push({y:d.getFullYear(),m:d.getMonth()+1,label:BN_MONTHS_SHORT[d.getMonth()]}); }
  const data = months.map(mo=>{
    const key = mo.y+'-'+String(mo.m).padStart(2,'0');
    return {label:mo.label,
      inc: db.payments.filter(p=>String(p.date).startsWith(key)).reduce((s,p)=>s+ +p.amount,0),
      exp: db.expenses.filter(e=>String(e.date).startsWith(key)).reduce((s,e)=>s+ +e.amount,0)};
  });
  const padL=52,padR=12,padT=14,padB=30,plotW=W-padL-padR,plotH=H-padT-padB;
  const maxVal = Math.max(1, ...data.map(d=>Math.max(d.inc,d.exp)));
  const step = niceStep(maxVal/4); const top = Math.ceil(maxVal/step)*step;
  ctx.strokeStyle=cLine; ctx.lineWidth=1; ctx.font='11px system-ui,sans-serif'; ctx.fillStyle=cMuted; ctx.textAlign='right'; ctx.textBaseline='middle';
  for(let v=0;v<=top+.001;v+=step){
    const y = padT+plotH-(v/top)*plotH;
    ctx.beginPath(); ctx.moveTo(padL,y); ctx.lineTo(W-padR,y); ctx.stroke();
    ctx.fillText(v>=1000?(v/1000).toFixed(v%1000===0?0:1)+'k':String(Math.round(v)), padL-9, y);
  }
  const groupW = plotW/data.length; const barW = Math.min(22, groupW*0.3); const gap=4;
  data.forEach((d,i)=>{
    const cx = padL+groupW*i+groupW/2;
    roundRect(ctx, cx-barW-gap/2, padT+plotH-(d.inc/top)*plotH, barW, (d.inc/top)*plotH, 4, cGreen);
    roundRect(ctx, cx+gap/2, padT+plotH-(d.exp/top)*plotH, barW, (d.exp/top)*plotH, 4, cRed);
    ctx.fillStyle=cMuted; ctx.textAlign='center'; ctx.textBaseline='top'; ctx.font='11px system-ui,sans-serif';
    ctx.fillText(d.label, cx, padT+plotH+9);
  });
  ctx.strokeStyle=cLine; ctx.lineWidth=1.4; ctx.beginPath(); ctx.moveTo(padL,padT+plotH); ctx.lineTo(W-padR,padT+plotH); ctx.stroke();
  function roundRect(c,x,y,w,h,r,color){ if(h<.5||w<.5) return; r=Math.min(r,w/2,h/2); c.beginPath(); c.moveTo(x+r,y); c.arcTo(x+w,y,x+w,y+h,r); c.arcTo(x+w,y+h,x,y+h,0); c.arcTo(x,y+h,x,y,0); c.arcTo(x,y,x+w,y,r); c.closePath(); c.fillStyle=color; c.fill(); }
  function niceStep(v){ const p=Math.pow(10,Math.floor(Math.log10(Math.max(v,1)))); const n=v/p; if(n<=1)return p; if(n<=2)return 2*p; if(n<=5)return 5*p; return 10*p; }
}

