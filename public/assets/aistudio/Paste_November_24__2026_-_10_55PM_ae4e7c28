    <p>${fmtDate(today())} • ${esc(db.settings.mosqueName||'মসজিদ')}</p>
    <div class="hero-actions">${admin?`<button onclick="editPrayerTimes()">⚙ সময় সম্পাদনা</button>`:''}</div>
  </div>

  <h3 class="section">আজকের নামাজ</h3>
  <div class="prayer-grid">${prayerCards}</div>
  <div class="notice info" style="margin-top:14px"><b>তথ্য:</b> ${current?'বর্তমান ওয়াক্ত: <b>'+labels[current]+'</b>':'এখনো ফজরের সময় হয়নি'} • জুম্মার সময়: <b>${esc(times.jummah||'—')}</b></div>

