function cleanLogs(){
  if(!requireAdmin()) return;
  if(!confirm('সাম্প্রতিক ২০০ লগ রেখে বাকি সব মুছে ফেলবেন?')) return;
  db.logs = db.logs.slice(0, 200); save(); render(); toast('লগ পরিষ্কার সম্পন্ন');
}
function validateData(){
  const issues = [];
  db.payments.forEach(p=>{ if(!db.families.find(f=>f.id===p.family)) issues.push('আদায় '+p.id+' — পরিবার নেই'); });
  db.members.forEach(m=>{ if(!db.families.find(f=>f.id===m.family)) issues.push('সদস্য '+m.id+' — পরিবার নেই'); });
  db.distributions.forEach(d=>{ if(!db.families.find(f=>f.id===d.family)) issues.push('বিতরণ '+d.id+' — পরিবার নেই'); });
  if(issues.length) toast(`${issues.length} টি সমস্যা পাওয়া গেছে`, 'warn');
  else toast('✓ সব ডেটা সঠিক');
}

/* ============ MAKE DISTRIBUTION ============ */
function makeDistribution(batchId){
  if(!requireAdmin()) return;
  const b = db.batches.find(x=>x.id===batchId); if(!b) return;
  const fs = activeFamilies();
  if(!fs.length){ toast('আগে পরিবার যোগ করুন','error'); return; }
  if(db.distributions.some(x=>x.batch===batchId)){ toast('এই অনুষ্ঠানের বণ্টন আগেই তৈরি','warn'); return; }
  const per = +(b.kg/fs.length).toFixed(3);
  b.families = fs.length; b.per = per;
  fs.forEach(f=>db.distributions.push({id:uid(), batch:batchId, family:f.id, allocated:per, delivered:0, status:'pending'}));
  log('গোশত বণ্টন তালিকা তৈরি','distributions', batchId); save();
  toast(`প্রতি পরিবার ${bn(per)} কেজি বরাদ্দ হয়েছে`); setPage('distribution');
}
function markDelivered(idv){
  if(!requireAdmin()) return;
  const x = db.distributions.find(d=>d.id===idv); if(!x) return;
  if(!confirm(`${familyName(x.family)} কি ${bn(x.allocated)} কেজি গোশত গ্রহণ করেছেন?`)) return;
  x.delivered = x.allocated; x.status = 'delivered'; x.receivedBy = familyName(x.family); x.receivedAt = new Date().toLocaleString('bn-BD');
  log('গোশত গ্রহণ নিশ্চিত','distributions', idv); save(); render(); toast('গ্রহণ নিশ্চিত');
}
