/* ============ VIEW: FINANCIAL ANALYTICS ============ */
function viewAnalytics(){
  const paid=totalPaid(), spent=totalSpent(), balance=paid-spent;
  const cats = {}; db.expenses.forEach(e=>{ const k=e.category||'অন্যান্য'; cats[k]=(cats[k]||0)+ +e.amount; });
  const catEntries = Object.entries(cats).sort((a,b)=>b[1]-a[1]);
  const maxCat = Math.max(1, ...catEntries.map(c=>c[1]));

  /* monthly trend */
  const now = new Date(); const months = [];
  for(let i=5;i>=0;i--){ const d=new Date(now.getFullYear(),now.getMonth()-i,1); months.push({y:d.getFullYear(),m:d.getMonth()+1,label:BN_MONTHS_SHORT[d.getMonth()]}); }
  const trend = months.map(mo=>{
    const key = mo.y+'-'+String(mo.m).padStart(2,'0');
    return {label:mo.label,
