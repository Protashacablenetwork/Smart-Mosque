const uid = () => (crypto.randomUUID ? crypto.randomUUID() : Date.now().toString(36)+Math.random().toString(36).slice(2,9));
const bn  = n => Number(n||0).toLocaleString('bn-BD',{maximumFractionDigits:3});
const bnf = n => Number(n||0).toLocaleString('bn-BD',{maximumFractionDigits:2});
const money = n => '৳ '+bnf(n);
