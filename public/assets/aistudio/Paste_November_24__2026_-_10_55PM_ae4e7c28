const BN_MONTHS_SHORT=['জানু','ফেব্রু','মার্চ','এপ্রিল','মে','জুন','জুলা','আগ','সেপ্ট','অক্টো','নভে','ডিসে'];
function fmtDate(s){
  if(!s) return '—';
  const p=String(s).split('-');
  if(p.length!==3 || isNaN(+p[0])) return esc(s);
  return `${bn(+p[2])} ${BN_MONTHS_SHORT[+p[1]-1]||''} ${bn(+p[0])}`;
}
function save(){ try{ localStorage.setItem(KEY, JSON.stringify(db)); }catch(e){ toast('সংরক্ষণে সমস্যা','error'); } }
function log(action, table, record){ db.logs.unshift({id:uid(), action, table, record, at:new Date().toLocaleString('bn-BD')}); db.logs = db.logs.slice(0,800); }
