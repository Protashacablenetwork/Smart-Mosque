<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0a7d52">
<title>মসজিদ ও সমাজ ব্যবস্থাপনা — সম্পূর্ণ সিস্টেম</title>
<style>
:root{
  --bg:#f1f5f2; --bg2:#ffffff; --card:#ffffff;
  --ink:#122019; --ink2:#2c3d34; --muted:#6b7b72;
  --line:#e3ebe6; --line2:#eef4f0;
  --green:#0a7d52; --green2:#0d9d68; --green-soft:#e7f4ed;
  --red:#c43d3d; --red-soft:#fdecec;
  --gold:#b8862a; --gold-soft:#fdf3e0;
  --blue:#2f6fed; --blue-soft:#eaf1fe;
  --purple:#7c4ddb; --purple-soft:#f2ecfe;
  --shadow:0 1px 2px rgba(16,40,28,.04), 0 8px 24px rgba(16,40,28,.06);
  --shadow-lg:0 20px 60px rgba(16,40,28,.18);
  --r:16px; --r-sm:11px;
  --side:250px;
  color-scheme:light;
}
[data-theme="dark"]{
  --bg:#0b1310; --bg2:#111b16; --card:#131f19;
  --ink:#e9f2ed; --ink2:#c3d5cb; --muted:#89a094;
  --line:#22322b; --line2:#1a2822;
  --green:#26a875; --green2:#33c08c; --green-soft:#12342a;
  --red:#e87070; --red-soft:#331a1b;
  --gold:#d9a545; --gold-soft:#2e2617;
  --blue:#5b8dff; --blue-soft:#16233f;
  --purple:#a988f0; --purple-soft:#221735;
  --shadow:0 1px 2px rgba(0,0,0,.35), 0 8px 24px rgba(0,0,0,.28);
  --shadow-lg:0 24px 70px rgba(0,0,0,.6);
  color-scheme:dark;
}
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Noto Sans Bengali",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;font-size:14.5px;line-height:1.6;-webkit-font-smoothing:antialiased;transition:background .25s,color .25s}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer;border:0;border-radius:var(--r-sm);padding:10px 15px;background:var(--green);color:#fff;font-weight:650;transition:.18s;letter-spacing:.1px}
button:hover{filter:brightness(1.07)}
button:active{transform:translateY(1px)}
button.secondary{background:var(--green-soft);color:var(--green)}
button.danger{background:var(--red-soft);color:var(--red)}
button.gold{background:var(--gold-soft);color:var(--gold)}
button.blue{background:var(--blue-soft);color:var(--blue)}
button.purple{background:var(--purple-soft);color:var(--purple)}
button.ghost{background:transparent;color:var(--muted);padding:8px 11px}
button.ghost:hover{background:var(--line2);color:var(--ink)}
button.sm{padding:6px 10px;font-size:12.5px;border-radius:8px}
input,select,textarea{width:100%;padding:11px 13px;border:1.5px solid var(--line);border-radius:var(--r-sm);background:var(--bg2);color:var(--ink);outline:none;transition:.18s}
input:focus,select:focus,textarea:focus{border-color:var(--green2);box-shadow:0 0 0 3.5px var(--green-soft)}
textarea{resize:vertical;min-height:80px}
select{appearance:none;background-image:linear-gradient(45deg,transparent 50%,var(--muted) 50%),linear-gradient(135deg,var(--muted) 50%,transparent 50%);background-position:calc(100% - 18px) 50%,calc(100% - 13px) 50%;background-size:5px 5px,5px 5px;background-repeat:no-repeat;padding-right:34px}
label{font-size:12.5px;font-weight:650;display:block;margin-bottom:6px;color:var(--ink2)}
::selection{background:var(--green-soft);color:var(--green)}

.app{display:grid;grid-template-columns:var(--side) 1fr;min-height:100vh}
.side{background:linear-gradient(168deg,#0d4230 0%,#0a2f22 55%,#082418 100%);color:#dcece4;padding:16px 12px;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;z-index:40}
.brand{display:flex;gap:10px;align-items:flex-start;padding:2px 8px 16px}
.brand .logo{width:38px;height:38px;flex:none;border-radius:12px;display:grid;place-items:center;font-size:19px;background:linear-gradient(150deg,#18b57c,#0a6d49);box-shadow:0 6px 18px rgba(0,0,0,.28)}
.brand b{font-size:14px;display:block;line-height:1.3;color:#fff;font-weight:800}
.brand small{display:block;font-size:10px;color:#8fbca8;font-weight:400;margin-top:2px}
.nav{display:flex;flex-direction:column;gap:2px;overflow-y:auto;flex:1;padding-right:2px;scrollbar-width:thin}
.nav::-webkit-scrollbar{width:5px}
.nav::-webkit-scrollbar-thumb{background:#ffffff22;border-radius:9px}
.nav .group-label{font-size:10px;font-weight:800;letter-spacing:1.2px;color:#5d8a76;padding:10px 10px 4px;text-transform:uppercase}
.nav .group-label:first-child{padding-top:0}
.nav button{background:transparent;text-align:left;color:#b9d6c7;font-weight:550;font-size:12.8px;padding:7px 10px;display:flex;gap:9px;align-items:center;border-radius:9px;position:relative}
.nav button .ni{width:17px;text-align:center;font-size:13px;opacity:.85;flex:none}
.nav button:hover{background:#ffffff12;color:#fff}
.nav button.active{background:linear-gradient(90deg,#ffffff1f,#ffffff08);color:#fff;font-weight:700}
.nav button.active::before{content:"";position:absolute;left:-12px;top:6px;bottom:6px;width:3px;border-radius:0 4px 4px 0;background:var(--green2)}
.sidefoot{padding:10px 8px 2px;color:#7fa994;font-size:10.5px;line-height:1.5;border-top:1px solid #ffffff14;margin-top:8px}
.overlay{position:fixed;inset:0;background:#04150ecc;z-index:39;display:none;backdrop-filter:blur(3px)}
.overlay.show{display:block}
.main{min-width:0;display:flex;flex-direction:column}
.top{min-height:72px;background:color-mix(in srgb,var(--bg2) 88%,transparent);border-bottom:1px solid var(--line);display:flex;align-items:center;gap:14px;padding:10px 26px;position:sticky;top:0;z-index:30;backdrop-filter:blur(16px) saturate(1.3)}
.top h1{font-size:17.5px;margin:0;font-weight:800;line-height:1.3}
.top .crumb{margin:1px 0 0;font-size:11.5px;color:var(--muted);font-weight:400}
.top-actions{margin-left:auto;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.icon-btn{background:var(--bg);color:var(--ink);border:1.5px solid var(--line);width:38px;height:38px;padding:0;display:grid;place-items:center;border-radius:11px;font-size:16px}
.icon-btn:hover{background:var(--green-soft);border-color:var(--green-soft);color:var(--green)}
.hamburger{display:none}
.wrap{padding:24px 26px 10px;max-width:1560px;width:100%;margin:0 auto;flex:1}
.footer{text-align:center;color:var(--muted);font-size:11.5px;padding:22px 16px 26px;opacity:.8}
.grid{display:grid;gap:14px}
.stats{grid-template-columns:repeat(4,minmax(0,1fr))}
.stats2{grid-template-columns:repeat(4,minmax(0,1fr))}
.card,.panel{background:var(--card);border:1.5px solid var(--line);border-radius:var(--r);padding:18px;box-shadow:var(--shadow);transition:.2s}
.card:hover{box-shadow:var(--shadow-lg);border-color:color-mix(in srgb,var(--green) 22%,var(--line))}
.stat{position:relative;overflow:hidden;display:flex;flex-direction:column;gap:4px}
.stat::after{content:"";position:absolute;right:-26px;top:-26px;width:88px;height:88px;border-radius:50%;background:var(--green-soft);opacity:.55;pointer-events:none}
.stat.t-red::after{background:var(--red-soft)}
.stat.t-gold::after{background:var(--gold-soft)}
.stat.t-blue::after{background:var(--blue-soft)}
.stat.t-purple::after{background:var(--purple-soft)}
.stat .st-top{display:flex;align-items:center;gap:9px;position:relative;z-index:1}
.stat .ico{width:34px;height:34px;flex:none;border-radius:10px;display:grid;place-items:center;font-size:15px;background:var(--green-soft);color:var(--green)}
.stat.t-red .ico{background:var(--red-soft);color:var(--red)}
.stat.t-gold .ico{background:var(--gold-soft);color:var(--gold)}
.stat.t-blue .ico{background:var(--blue-soft);color:var(--blue)}
.stat.t-purple .ico{background:var(--purple-soft);color:var(--purple)}
.stat small{color:var(--muted);font-size:12.5px;font-weight:600}
.stat strong{display:block;font-size:24px;font-weight:800;letter-spacing:-.4px;margin-top:6px;position:relative;z-index:1}
.stat .sub{font-size:11.5px;color:var(--muted);font-weight:500}
.section{font-size:16px;font-weight:800;margin:26px 0 12px;display:flex;align-items:center;gap:10px}
.section::before{content:"";width:4px;height:17px;border-radius:3px;background:linear-gradient(180deg,var(--green2),var(--green))}
.section .count{font-size:11.5px;font-weight:600;color:var(--muted);background:var(--line2);padding:2px 9px;border-radius:20px}
.toolbar{display:flex;gap:9px;flex-wrap:wrap;align-items:center;margin-bottom:16px}
.toolbar .spacer{flex:1}
.searchbox{position:relative;flex:1;max-width:330px;min-width:180px}
.searchbox input{padding-left:36px}
.searchbox::before{content:"⌕";position:absolute;left:13px;top:50%;transform:translateY(-50%);color:var(--muted);font-size:16px;pointer-events:none}
.table-wrap{background:var(--card);border:1.5px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);overflow:auto}
table{width:100%;border-collapse:collapse;min-width:680px}
th,td{text-align:left;padding:12px 14px;border-bottom:1px solid var(--line2);font-size:13.5px;vertical-align:middle}
th{color:var(--muted);font-weight:700;font-size:11.5px;text-transform:uppercase;letter-spacing:.5px;background:color-mix(in srgb,var(--bg) 55%,var(--card));position:sticky;top:0;z-index:1;border-bottom:1.5px solid var(--line);white-space:nowrap}
tbody tr{transition:background .13s}
tbody tr:hover{background:color-mix(in srgb,var(--green-soft) 42%,transparent)}
tbody tr:last-child td{border-bottom:0}
td .act{margin:2px 3px 2px 0}
td.num,th.num{text-align:right;font-variant-numeric:tabular-nums;font-weight:650}
.badge{display:inline-flex;align-items:center;gap:5px;padding:3.5px 10px;border-radius:20px;background:var(--green-soft);color:var(--green);font-size:11.5px;font-weight:700;white-space:nowrap}
.badge.warn{background:var(--gold-soft);color:var(--gold)}
.badge.red{background:var(--red-soft);color:var(--red)}
.badge.gray{background:var(--line2);color:var(--muted)}
.badge.blue{background:var(--blue-soft);color:var(--blue)}
.badge.purple{background:var(--purple-soft);color:var(--purple)}
.badge::before{content:"";width:5px;height:5px;border-radius:50%;background:currentColor;opacity:.85}
.muted{color:var(--muted)}
.mono{font-variant-numeric:tabular-nums}
.empty{text-align:center;padding:46px 20px;color:var(--muted)}
.empty .big{font-size:34px;display:block;margin-bottom:8px;opacity:.45}
.notice{padding:13px 16px;border-radius:var(--r-sm);background:var(--gold-soft);color:var(--gold);font-size:12.8px;font-weight:550;line-height:1.65;border:1px solid color-mix(in srgb,var(--gold) 20%,transparent)}
.notice.info{background:var(--blue-soft);color:var(--blue);border-color:color-mix(in srgb,var(--blue) 20%,transparent)}
.notice.ok{background:var(--green-soft);color:var(--green);border-color:color-mix(in srgb,var(--green) 20%,transparent)}
.notice b{font-weight:800}
.quick{display:flex;gap:9px;flex-wrap:wrap}
.quick button{font-size:13px}
.chart-card{padding:18px 18px 10px}
.card-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px;flex-wrap:wrap}
.card-head h3{margin:0;font-size:15px;font-weight:800}
.legend{display:flex;gap:14px;font-size:11.5px;color:var(--muted);font-weight:600}
.legend i{display:inline-block;width:9px;height:9px;border-radius:3px;margin-right:5px;vertical-align:middle}
canvas.chart{display:block;width:100%;height:230px}
.progress{height:8px;background:var(--line2);border-radius:9px;overflow:hidden;min-width:80px}
.progress span{display:block;height:100%;border-radius:9px;background:linear-gradient(90deg,var(--green2),var(--green));transition:width .5s}
.bar-row{display:grid;grid-template-columns:130px 1fr 84px;gap:12px;align-items:center;padding:7px 0;font-size:13px}
.bar-row .bl{color:var(--ink2);font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.bar-row .bv{text-align:right;font-weight:700;font-variant-numeric:tabular-nums}
.bar-track{height:9px;background:var(--line2);border-radius:9px;overflow:hidden}
.bar-track i{display:block;height:100%;border-radius:9px;background:linear-gradient(90deg,var(--green2),var(--green))}
.modal{position:fixed;inset:0;background:rgba(6,24,16,.62);backdrop-filter:blur(5px);display:none;align-items:center;justify-content:center;padding:16px;z-index:60;overflow-y:auto}
.modal.show{display:flex;animation:fade .18s ease}
@keyframes fade{from{opacity:0}to{opacity:1}}
.dialog{background:var(--card);border-radius:20px;width:min(680px,100%);max-height:92vh;display:flex;flex-direction:column;box-shadow:var(--shadow-lg);border:1.5px solid var(--line);animation:pop .22s cubic-bezier(.2,.9,.3,1.2)}
@keyframes pop{from{opacity:0;transform:translateY(14px) scale(.97)}to{opacity:1;transform:none}}
.dialog header{padding:20px 22px 14px;border-bottom:1px solid var(--line2);display:flex;align-items:center;gap:10px}
.dialog header h3{margin:0;font-size:16.5px;font-weight:800}
.dialog .body{padding:18px 22px;overflow-y:auto}
.dialog footer{padding:14px 22px 18px;display:flex;justify-content:flex-end;gap:9px;border-top:1px solid var(--line2);flex-wrap:wrap}
.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:13px}
.formgrid .field.full{grid-column:1/-1}
.formgrid .req{color:var(--red);font-weight:800}
.dl{display:grid;grid-template-columns:auto 1fr;gap:9px 16px;font-size:13.5px}
.dl dt{color:var(--muted);font-weight:600;white-space:nowrap}
.dl dd{margin:0;font-weight:600}
#toasts{position:fixed;right:18px;bottom:18px;z-index:90;display:flex;flex-direction:column;gap:9px;pointer-events:none}
.toast{background:var(--ink);color:var(--bg2);padding:12px 17px;border-radius:12px;font-size:13px;font-weight:600;box-shadow:var(--shadow-lg);animation:slideIn .25s ease;max-width:330px;border-left:3.5px solid var(--green2)}
.toast.error{border-left-color:var(--red)}
.toast.warn{border-left-color:var(--gold)}
.toast.out{animation:slideOut .3s ease forwards}
@keyframes slideIn{from{opacity:0;transform:translateX(28px)}to{opacity:1;transform:none}}
@keyframes slideOut{to{opacity:0;transform:translateX(28px)}}
.hidden{display:none!important}
.hero{background:linear-gradient(135deg,var(--green),#0a5c3d);color:#fff;padding:26px;border-radius:var(--r);position:relative;overflow:hidden}
.hero::before{content:"🕌";position:absolute;right:-10px;top:-20px;font-size:160px;opacity:.06;line-height:1}
.hero h2{margin:0 0 4px;font-size:22px;font-weight:800}
.hero p{margin:0;opacity:.85;font-size:13px}
.hero .hero-actions{margin-top:16px;display:flex;gap:8px;flex-wrap:wrap}
.hero .hero-actions button{background:rgba(255,255,255,.15);color:#fff;backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.2)}
.hero .hero-actions button:hover{background:rgba(255,255,255,.25)}
.prayer-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}
.prayer-card{background:var(--card);border:1.5px solid var(--line);border-radius:var(--r);padding:16px 12px;text-align:center;transition:.2s;cursor:pointer}
.prayer-card:hover{border-color:var(--green);transform:translateY(-2px);box-shadow:var(--shadow-lg)}
.prayer-card.now{background:linear-gradient(150deg,var(--green-soft),var(--card));border-color:var(--green)}
.prayer-card .p-name{font-size:12px;color:var(--muted);font-weight:700;letter-spacing:.5px}
.prayer-card .p-time{font-size:20px;font-weight:800;margin-top:6px;color:var(--green)}
.prayer-card .p-icon{font-size:20px;margin-bottom:4px;opacity:.7}
.cal-item{display:flex;gap:14px;padding:12px 0;border-bottom:1px solid var(--line2)}
.cal-item:last-child{border-bottom:0}
.cal-date{width:54px;flex:none;text-align:center;background:var(--green-soft);border-radius:11px;padding:6px 4px}
.cal-date .d{font-size:20px;font-weight:800;color:var(--green);line-height:1}
.cal-date .m{font-size:10.5px;font-weight:700;color:var(--green);text-transform:uppercase;margin-top:3px}
.cal-body{flex:1;min-width:0}
.cal-body b{font-size:14px;display:block;margin-bottom:2px}
.cal-body p{margin:0;font-size:12.5px;color:var(--muted)}
.chip{display:inline-block;padding:3px 10px;border-radius:20px;background:var(--line2);color:var(--ink2);font-size:11px;font-weight:650;margin-right:4px}
.switch{position:relative;display:inline-block;width:44px;height:24px;flex:none}
.switch input{opacity:0;width:0;height:0}
.switch .slider{position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background:var(--line);transition:.3s;border-radius:24px}
.switch .slider:before{content:"";position:absolute;height:18px;width:18px;left:3px;bottom:3px;background:#fff;transition:.3s;border-radius:50%}
.switch input:checked + .slider{background:var(--green)}
.switch input:checked + .slider:before{transform:translateX(20px)}
.setting-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 0;border-bottom:1px solid var(--line2);flex-wrap:wrap}
.setting-row:last-child{border-bottom:0}
.setting-row .sr-info{flex:1;min-width:200px}
.setting-row b{display:block;font-size:14px;margin-bottom:2px}
.setting-row small{color:var(--muted);font-size:12px}
.health-item{display:flex;align-items:center;gap:12px;padding:14px;background:var(--bg);border-radius:var(--r-sm);border:1.5px solid var(--line);margin-bottom:10px}
.health-item .hi-icon{width:40px;height:40px;flex:none;border-radius:11px;display:grid;place-items:center;font-size:18px;background:var(--green-soft);color:var(--green)}
.health-item.warn .hi-icon{background:var(--gold-soft);color:var(--gold)}
.health-item.bad .hi-icon{background:var(--red-soft);color:var(--red)}
.health-item .hi-body{flex:1;min-width:0}
.health-item b{display:block;font-size:13.5px;margin-bottom:2px}
.health-item small{color:var(--muted);font-size:12px}
.health-item .hi-val{font-weight:800;font-size:15px;white-space:nowrap}
.metric-row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:16px}
.metric{background:var(--card);border:1.5px solid var(--line);border-radius:var(--r-sm);padding:14px}
.metric .mv{font-size:22px;font-weight:800;letter-spacing:-.4px}
.metric .ml{font-size:11.5px;color:var(--muted);font-weight:600;margin-top:2px}
.tabs{display:flex;gap:2px;border-bottom:1.5px solid var(--line);margin-bottom:16px;overflow-x:auto}
.tabs button{background:transparent;color:var(--muted);border-radius:0;border-bottom:2.5px solid transparent;margin-bottom:-1.5px;padding:10px 14px;font-size:13px;white-space:nowrap}
.tabs button:hover{color:var(--ink);background:var(--line2)}
.tabs button.active{color:var(--green);border-bottom-color:var(--green);font-weight:700;background:transparent}
@media(max-width:1080px){.stats,.stats2{grid-template-columns:repeat(2,minmax(0,1fr))}.metric-row{grid-template-columns:repeat(2,1fr)}.prayer-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:900px){.app{grid-template-columns:1fr}.side{position:fixed;left:0;top:0;bottom:0;width:270px;height:100vh;transform:translateX(-104%);transition:transform .26s cubic-bezier(.3,.9,.3,1);box-shadow:var(--shadow-lg);padding-top:18px}.side.open{transform:none}.hamburger{display:grid}.top{padding:10px 16px;min-height:64px;gap:10px}.top h1{font-size:15px}.wrap{padding:16px 14px 6px}.section{margin-top:20px}}
@media(max-width:620px){.stats,.stats2{grid-template-columns:1fr 1fr;gap:9px}.card{padding:14px}.stat strong{font-size:20px}.stat .ico{width:29px;height:29px;font-size:13px}.formgrid{grid-template-columns:1fr}.toolbar>*{flex:1 1 100%}.searchbox{max-width:none}.bar-row{grid-template-columns:100px 1fr 72px;font-size:12.5px}.dialog{border-radius:16px}.dialog header,.dialog .body,.dialog footer{padding-left:16px;padding-right:16px}#toasts{left:14px;right:14px;bottom:14px}.toast{max-width:none}.prayer-grid{grid-template-columns:repeat(3,1fr)}.prayer-card{padding:12px 6px}.prayer-card .p-time{font-size:16px}.metric-row{grid-template-columns:1fr 1fr}}
@media print{.side,.top,.toolbar,.no-print,#toasts,.footer,.hamburger,.icon-btn{display:none!important}body{background:#fff}.app{display:block}.wrap{padding:0;max-width:none}.card,.panel,.table-wrap{box-shadow:none;border-color:#ddd;break-inside:avoid}table{min-width:0}}
</style>
</head>
<body>

<div class="app">
  <aside class="side" id="sidebar">
    <div class="brand">
      <div class="logo">🕌</div>
      <div><b>মসজিদ ও সমাজ<br>ব্যবস্থাপনা</b><small>সম্পূর্ণ স্মার্ট সিস্টেম</small></div>
