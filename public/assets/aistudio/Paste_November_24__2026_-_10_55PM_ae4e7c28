function toast(msg, type){
  const el=document.createElement('div'); el.className='toast '+(type||''); el.textContent=msg;
  $('#toasts').appendChild(el);
  setTimeout(()=>{ el.classList.add('out'); setTimeout(()=>el.remove(),320); }, 2800);
}
function familyName(fid){ return db.families.find(x=>x.id===fid)?.name || '—'; }
function duename(did){ return db.dues.find(x=>x.id===did)?.title || 'সাধারণ চাঁদা'; }
function batchName(bid){ return db.batches.find(x=>x.id===bid)?.name || '—'; }
function totalPaid(){ return db.payments.reduce((s,x)=>s+ +x.amount,0); }
function totalSpent(){ return db.expenses.reduce((s,x)=>s+ +x.amount,0); }
function activeFamilies(){ return db.families.filter(f=>f.active!==false); }
function familyDue(fid){
  const base = db.dues.filter(d=>d.active!==false).reduce((s,d)=>s+ +d.amount,0);
  const paid = db.payments.filter(p=>p.family===fid).reduce((s,p)=>s+ +p.amount,0);
  return Math.max(0, base - paid);
}
function totalOutstanding(){ return activeFamilies().reduce((s,f)=>s+familyDue(f.id),0); }
function genReceipt(){
  const d=new Date(), p=n=>String(n).padStart(2,'0');
  const base='MS-'+d.getFullYear()+p(d.getMonth()+1)+p(d.getDate())+'-';
  let n=1, r;
  do { r = base + String(n).padStart(3,'0'); n++; } while(db.payments.some(x=>x.receipt===r) && n<999);
  return r;
}

